# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The real .env file must NEVER be committed to GitHub.
# ---------------------------------------------------------------

# MongoDB connection string.
# Local MongoDB example:
#   mongodb://127.0.0.1:27017/authapp
# MongoDB Atlas example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/authapp?retryWrites=true&w=majority
MONGODB_URI=

# A long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port used when running locally
PORT=3000
