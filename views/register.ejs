<%- include('partials/header') %>

<div class="card auth-card">
  <div class="card-head">
    <h1>Create your account</h1>
    <p class="subtitle">Register to get access to the protected pages.</p>
  </div>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach(function (err) { %>
          <li><%= err %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/register" method="POST" novalidate id="registerForm">
    <div class="field">
      <label for="name">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Ali Khan"
        value="<%= formData && formData.name ? formData.name : '' %>"
        required
        autocomplete="name"
      />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="ali@example.com"
        value="<%= formData && formData.email ? formData.email : '' %>"
        required
        autocomplete="email"
      />
    </div>

    <div class="field">
      <label for="password">Password</label>
      <div class="password-wrap">
        <input
          type="password"
          id="password"
          name="password"
          placeholder="At least 6 characters"
          required
          minlength="6"
          autocomplete="new-password"
        />
        <button type="button" class="toggle-password" data-target="password" aria-label="Show password">Show</button>
      </div>
      <small class="hint">Minimum 6 characters.</small>
    </div>

    <div class="field">
      <label for="confirmPassword">Confirm Password</label>
      <div class="password-wrap">
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          placeholder="Repeat your password"
          required
          minlength="6"
          autocomplete="new-password"
        />
        <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Show password">Show</button>
      </div>
      <small class="hint" id="matchHint"></small>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Register</button>
  </form>

  <p class="form-foot">
    Already registered? <a href="/login">Login here</a>
  </p>
</div>

<%- include('partials/footer') %>
