<%- include('partials/header') %>

<div class="card auth-card">
  <div class="card-head">
    <h1>Welcome back</h1>
    <p class="subtitle">Login to access your dashboard and profile.</p>
  </div>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach(function (err) { %>
          <li><%= err %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/login" method="POST" novalidate id="loginForm">
    <div class="field">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="you@example.com"
        value="<%= formData && formData.email ? formData.email : '' %>"
        required
        autocomplete="email"
      />
    </div>

    <div class="field">
      <label for="password">Password</label>
      <div class="password-wrap">
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Your password"
          required
          autocomplete="current-password"
        />
        <button type="button" class="toggle-password" data-target="password" aria-label="Show password">Show</button>
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Login</button>
  </form>

  <p class="form-foot">
    Don&rsquo;t have an account? <a href="/register">Create one</a>
  </p>
</div>

<%- include('partials/footer') %>
